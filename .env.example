# ---------------------------------------------------------------------------
# Ojà Live — environment template
#
# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
#   cp .env.example .env
#
# Only SANDBOX / TEST payment keys belong in this project. Never live keys.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug
TZ=UTC

# --- API -------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Postgres (local Docker; Neon connection string in staging/production) --
# Local:  postgresql://ojalive:ojalive@localhost:55436/ojalive
# Neon:   postgresql://USER:PASSWORD@HOST.eu-west-2.aws.neon.tech/ojalive?sslmode=require
DATABASE_URL=
DATABASE_POOL_MAX=10

# --- Redis (local Docker; own Fly machine in production) -------------------
REDIS_URL=redis://localhost:56386

# --- Auth ------------------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
SOCKET_TOKEN_SECRET=
# Encryption key for sensitive fields (IMEI, ID, BVN). 32 bytes, hex.
FIELD_ENCRYPTION_KEY=

# --- Payments (SANDBOX / TEST keys only) -----------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# --- Storage (Cloudflare R2, private bucket) -------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Notifications ---------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
TERMII_API_KEY=
TERMII_SENDER_ID=
# Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:asgatcreation@gmail.com

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=

# --- Feature flags ---------------------------------------------------------
# See docs/MILESTONE-1-DESIGN.md §8.1
FEATURE_STRICT_DURABILITY=false
STRICT_DURABILITY_ABOVE_KOBO=100000000
FEATURE_DEMO_BOTS=false
FEATURE_LIVE_HYBRID_AUCTIONS=false
FEATURE_SEALED_BID_TENDERS=false
FEATURE_REAL_ESTATE=false
