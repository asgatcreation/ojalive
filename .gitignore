coverage/
.turbo/
.vitest/
playwright-report/
test-results/
.eslintcache

# load test output
load-tests/results/

# local data
infra/data/

# editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
pnpm-debug.log*
