// A single project that covers EVERY TypeScript file, including tests and config
// files, so that type-aware lint rules work everywhere. It emits nothing; the
// real builds use each package's own tsconfig.json.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "dom", "dom.iterable"],
    "jsx": "preserve",
    "types": ["node"],
    "allowJs": true,
    // Resolve workspace packages to their SOURCES. Each package's package.json
    // points at its built dist, which does not exist when CI lints before it
    // builds — and an unresolved type makes every no-unsafe-* rule fire on code
    // that is actually fine. This mirrors the same aliasing in vitest.config.ts.
    "baseUrl": ".",
    "paths": {
      "@ojalive/shared": ["packages/shared/src/index.ts"],
      "@ojalive/bid-engine": ["packages/bid-engine/src/index.ts"],
      "@ojalive/payments": ["packages/payments/src/index.ts"]
    }
  },
  "include": [
    "*.ts",
    "*.mts",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/*.ts",
    "packages/*/src/**/*.ts",
    "load-tests/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**", "**/.next/**"]
}
