// A single project that covers EVERY TypeScript file, including tests and config
// files, so that type-aware lint rules work everywhere. It emits nothing; the
// real builds use each package's own tsconfig.json.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "dom", "dom.iterable"],
    "jsx": "preserve",
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "*.ts",
    "*.mts",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/*.ts",
    "packages/*/src/**/*.ts",
    "load-tests/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**", "**/.next/**"]
}
